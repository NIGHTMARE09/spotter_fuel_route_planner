{
  "info": {
    "name": "Spotter Fuel Route API",
    "description": "Cheapest fuel stops along a US driving route.\n\nSetup: `pip install -r requirements.txt`, `python manage.py migrate`, `python manage.py load_stations`, `python manage.py runserver`. Set `baseUrl` if not 127.0.0.1:8000.\n\nOptional parameters: start_fuel_gallons (default 50 = full), corridor_miles (10), stop_cost ($5 a stop is worth avoiding; 0 = cheapest fuel only), reserve_miles (0).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:8000"
    }
  ],
  "event": [
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "if (pm.response.code === 200) {",
          "  const d = pm.response.json();",
          "  pm.test('few external API calls (OSRM once, plus Nominatim for free-text places)', () => pm.expect(d.meta.external_api_calls).to.be.at.most(3));",
          "  pm.test('total fuel cost is a number', () => pm.expect(d.summary.total_fuel_cost).to.be.a('number'));",
          "  pm.test('total equals the sum of the stops', () => pm.expect(d.summary.total_fuel_cost).to.be.closeTo(d.fuel_stops.reduce((a, s) => a + s.cost, 0), 0.005));",
          "  pm.test('every stop is within one tank of the previous', () => {",
          "    let last = 0;",
          "    d.fuel_stops.forEach(s => { pm.expect(s.mile_marker - last).to.be.at.most(d.assumptions.max_range_miles); last = s.mile_marker; });",
          "    pm.expect(d.route.distance_miles - last).to.be.at.most(d.assumptions.max_range_miles);",
          "  });",
          "  console.log('map:', d.map_url);",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "Coast to coast - New York, NY to Los Angeles, CA",
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/route/?start=New York, NY&finish=Los Angeles, CA",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "route",
            ""
          ],
          "query": [
            {
              "key": "start",
              "value": "New York, NY"
            },
            {
              "key": "finish",
              "value": "Los Angeles, CA"
            }
          ]
        }
      }
    },
